---
import { mainNavigation } from '../data/navigation';

interface Props { currentPath?: string; }
const { currentPath = '/' } = Astro.props;
const nav = mainNavigation.filter((item) => item.label !== 'Home');
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href);
---
<header class="topbar">
  <div class="home-wrap topbar__inner">
    <a class="brand" href="/" aria-current={currentPath === '/' ? 'page' : undefined}>
      <img class="brand__logo" src="/wp-content/uploads/2023/02/Frame-700-1.svg" alt="Logo van Interieurdesignerweb.nl" width="42" height="42" />
      <span class="brand__text">Interieurdesignerweb.nl</span>
    </a>
    <nav class="nav" aria-label="Hoofdmenu">
      <ul class="nav__list">
        {nav.map((item) => (
          <li class:list={['nav__item', { 'nav__item--has-children': !!item.children?.length, 'nav__item--active': isActive(item.href) }]}>
            <a class="nav__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}{item.children?.length ? <span class="nav__caret" aria-hidden="true"></span> : null}
            </a>
            {item.children?.length ? <ul class="nav__submenu" role="list">{item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}</ul> : null}
          </li>
        ))}
      </ul>
    </nav>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu"><span></span><span></span></button>
  </div>
  <div class="mobile-nav" id="mobile-nav" hidden>
    <div class="home-wrap">
      {nav.map((item) => (
        <div class:list={['mobile-nav__group', { 'mobile-nav__group--has-children': !!item.children?.length }]}>
          <div class="mobile-nav__row">
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            {item.children?.length ? <button class="mobile-nav__expand" type="button" aria-expanded="false" aria-label={`${item.label} submenu`}><span aria-hidden="true"></span></button> : null}
          </div>
          {item.children?.length ? <ul class="mobile-nav__submenu" hidden>{item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}</ul> : null}
        </div>
      ))}
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const panel = document.querySelector('#mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel instanceof HTMLElement) panel.hidden = open;
  });
  document.querySelectorAll('.mobile-nav__expand').forEach((button) => button.addEventListener('click', () => {
    const expanded = button.getAttribute('aria-expanded') === 'true';
    const submenu = button.closest('.mobile-nav__group')?.querySelector('.mobile-nav__submenu');
    button.setAttribute('aria-expanded', String(!expanded));
    if (submenu instanceof HTMLElement) submenu.hidden = expanded;
  }));
</script>

<style>
  .topbar { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid var(--home-line); background: rgba(244,246,244,.92); backdrop-filter: blur(14px); }
  .topbar__inner { display: flex; min-height: 4.1rem; align-items: center; justify-content: space-between; gap: 1.25rem; }
  .brand { display: inline-flex; align-items: center; gap: .65rem; min-width: 0; }
  .brand__logo { width: 2.25rem; height: 2.25rem; object-fit: contain; }
  .brand__text { font-family: var(--font-display); font-size: 1rem; font-weight: 700; letter-spacing: -.03em; white-space: nowrap; }
  .nav { display: none; align-items: center; }
  .nav__list { display: flex; align-items: center; gap: .25rem .95rem; margin: 0; padding: 0; list-style: none; }
  .nav__item { position: relative; }
  .nav__link { display: inline-flex; align-items: center; gap: .35rem; padding: 1.35rem 0 1.2rem; color: var(--home-ink-soft); font-size: .9rem; font-weight: 600; line-height: 1; transition: color .2s var(--home-ease); }
  .nav__link::after { position: absolute; right: 0; bottom: .7rem; left: 0; height: 2px; background: var(--home-moss); content: ''; transform: scaleX(0); transform-origin: center; transition: transform .22s var(--home-ease); }
  .nav__link:hover, .nav__item--has-children:hover > .nav__link, .nav__item--has-children:focus-within > .nav__link, .nav__item--active > .nav__link { color: var(--home-moss); }
  .nav__link:hover::after, .nav__item--active > .nav__link::after { transform: scaleX(1); }
  .nav__caret { width: 0; height: 0; border-right: 4px solid transparent; border-left: 4px solid transparent; border-top: 5px solid currentColor; opacity: .7; }
  .nav__submenu { position: absolute; top: calc(100% - .25rem); left: -.8rem; z-index: 50; min-width: 15.5rem; margin: 0; padding: .45rem 0; list-style: none; border: 1px solid var(--home-line); background: var(--home-white); box-shadow: 0 14px 30px rgba(16,22,18,.12); opacity: 0; pointer-events: none; transform: translateY(6px); transition: opacity .2s var(--home-ease), transform .2s var(--home-ease); visibility: hidden; }
  .nav__item--has-children:hover > .nav__submenu, .nav__item--has-children:focus-within > .nav__submenu { opacity: 1; pointer-events: auto; transform: none; visibility: visible; }
  .nav__submenu a { display: block; padding: .55rem 1rem; color: var(--home-ink-soft); font-size: .88rem; transition: background .2s var(--home-ease), color .2s var(--home-ease); }
  .nav__submenu a:hover { background: rgba(36,92,69,.08); color: var(--home-moss-deep); }
  .nav-toggle { display: inline-flex; width: 2.45rem; height: 2.45rem; flex-direction: column; justify-content: center; gap: .32rem; padding: .55rem; border: 1px solid var(--home-line); background: transparent; cursor: pointer; }
  .nav-toggle span { height: 2px; background: var(--home-moss-deep); }
  .mobile-nav { border-top: 1px solid var(--home-line); padding: .5rem 0 1.2rem; background: var(--home-paper); }
  .mobile-nav__group { border-bottom: 1px solid var(--home-line); }
  .mobile-nav__row { display: flex; align-items: center; gap: .5rem; }
  .mobile-nav__row > a { flex: 1; padding: .85rem 0; font-weight: 600; }
  .mobile-nav__row > a[aria-current='page'] { color: var(--home-moss); }
  .mobile-nav__expand { display: inline-flex; width: 2.4rem; height: 2.4rem; align-items: center; justify-content: center; border: 1px solid var(--home-line); background: transparent; cursor: pointer; }
  .mobile-nav__expand span { width: 0; height: 0; border-right: 5px solid transparent; border-bottom: 0; border-left: 5px solid transparent; border-top: 6px solid var(--home-ink); transition: transform .2s var(--home-ease); }
  .mobile-nav__expand[aria-expanded='true'] span { transform: rotate(180deg); }
  .mobile-nav__submenu { margin: 0 0 .75rem; padding: 0 0 .35rem .75rem; list-style: none; }
  .mobile-nav__submenu a { display: block; padding: .45rem 0; color: var(--home-ink-soft); font-size: .94rem; }
  @media (min-width: 800px) { .nav { display: flex; } .nav-toggle, .mobile-nav { display: none !important; } }
  @media (max-width: 420px) { .brand__text { font-size: .88rem; } .brand__logo { width: 2rem; height: 2rem; } }
</style>
