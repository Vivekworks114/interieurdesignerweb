---
import { getCollection } from 'astro:content';
import CmsBlogCards from '../../components/CmsBlogCards.astro';
import ElementorPageLayout from '../../layouts/ElementorPageLayout.astro';
import { migratedBlogSlugs } from '../../lib/blog';
import pageData from '../../data/blog/page-1.json';
import blogHtml from '../../data/elementor/blog/page-1.html?raw';

const cmsPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && !migratedBlogSlugs.has(post.data.slug || post.id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Keep the extracted Elementor page intact, inserting CMS-only cards before its grid closes.
const gridCloseIndex = blogHtml.indexOf('</div>\n<nav aria-label="Paginering"');
if (gridCloseIndex === -1) throw new Error('Could not find the Elementor blog grid boundary.');
const gridBeforeCards = blogHtml.slice(0, gridCloseIndex);
const gridAfterCards = blogHtml.slice(gridCloseIndex);
---
<ElementorPageLayout {...pageData} canonicalPath={pageData.path}>
  <Fragment set:html={gridBeforeCards} />
  <CmsBlogCards posts={cmsPosts} />
  <Fragment set:html={gridAfterCards} />
</ElementorPageLayout>
